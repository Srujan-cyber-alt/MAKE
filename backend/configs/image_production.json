{
  "model_name": "make-image-production",
  "arch": {
    "hidden_dim": 2048,
    "num_layers": 30,
    "num_heads": 16,
    "ffn_mult": 4,
    "text_embed_dim": 1024,
    "time_embed_dim": 2048,
    "identity_dim": 1024,
    "object_dim": 1024,
    "scene_dim": 1024,
    "default_short_side": 256,
    "patch_size": 2,
    "latent_channels": 4,
    "image_channels": 3,
    "text_vocab_size": 4096,
    "text_seq_len": 16,
    "use_rope": true,
    "use_qk_norm": true,
    "use_gradient_checkpointing": true
  },
  "max_steps": 100000,
  "batch_size": 1,
  "grad_accum_steps": 8,
  "learning_rate": 1e-4,
  "weight_decay": 0.01,
  "warmup_steps": 2000,
  "dtype": "float32",
  "grad_clip": 1.0,
  "use_gradient_checkpointing": true,
  "save_every_steps": 5000,
  "validate_every_steps": 10000,
  "output_dir": "./outputs",
  "seed": 42
}
