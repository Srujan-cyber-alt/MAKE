# Application
APP_NAME=MAKE AI Video
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-in-production-use-strong-random-key

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://makeai:makeai_password@localhost:5432/makeai_video

# Redis
REDIS_URL=redis://localhost:6379/0

# Storage
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=/tmp/makeai-storage
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=makeai-video

# Provider Configuration
# Add your actual provider API keys here
RUNWAY_API_KEY=
RUNWAY_API_BASE=https://api.runwayml.com/v1
PIKA_API_KEY=
PIKA_API_BASE=https://api.pika.art/v1
REPLICATE_API_TOKEN=
REPLICATE_API_BASE=https://api.replicate.com/v1
STABILITY_API_KEY=
STABILITY_API_BASE=https://api.stability.ai/v1

# Default provider: runway | pika | replicate | stability
DEFAULT_VIDEO_PROVIDER=runway

# Security
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate Limiting
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_GENERATION=10/hour

# Observability
SENTRY_DSN=
LOG_LEVEL=INFO

# Worker
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
